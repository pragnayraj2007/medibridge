{
  "expo": {
    "name": "MediBridge",
    "slug": "medibridge-patient",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "medibridge",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.medibridge.patient"
    },
    "android": {
      "package": "com.medibridge.patient",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#EEF5FF"
      },
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "MediBridge uses the microphone so you can answer the intake questions by voice."
        }
      ]
    ]
  }
}
